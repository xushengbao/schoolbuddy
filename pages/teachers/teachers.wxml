<view class="page">
  <view class="card">
    <view class="card-title">
      <text>教师状态</text>
      <text class="link" wx:if="{{isAdmin}}" bindtap="goImport">导入教师</text>
    </view>
    <view class="group-bar">
      <view class="gb {{group === '' ? 'on' : ''}}" bindtap="pickGroup" data-g="">全部</view>
      <view class="gb {{group === item ? 'on' : ''}}" wx:for="{{groups}}" wx:key="*this"
        bindtap="pickGroup" data-g="{{item}}">{{item}}</view>
    </view>

    <view class="stat-row">
      <view class="stat" wx:for="{{stats}}" wx:key="status">
        <view class="stat-num" style="color:{{item.color}}">{{item.count}}</view>
        <view class="stat-label">{{item.status}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">我的状态</view>
    <view class="opt-row">
      <view class="opt {{myStatus === item ? 'on' : ''}}" wx:for="{{statusOptions}}" wx:key="*this"
        bindtap="setMyStatus" data-v="{{item}}">{{item}}</view>
    </view>
    <view class="muted">当前：{{myStatus}}　{{myGroup}}</view>
  </view>

  <view class="card">
    <view class="card-title">全校教师</view>
    <view wx:if="{{teachers.length === 0}}" class="empty">暂无教师数据</view>
    <view class="teacher-row" wx:for="{{teachers}}" wx:key="id" bindtap="openTeacher" data-id="{{item.id}}">
      <view class="avatar">{{item.name[0]}}</view>
      <view class="t-main">
        <view class="t-name">{{item.name}}</view>
        <view class="muted">{{item.subject_group || '未分组'}}　{{item.account || '未设置账号'}}</view>
      </view>
      <text class="tag" style="background:{{item.bg}};color:{{item.color}}">{{item.status}}</text>
    </view>
  </view>

  <view style="height:40rpx"></view>
</view>