/* 调休设置页：列表 + 弹层
   （app.wxss 的 .card/.btn/.input 等通用样式不再重复定义） */

.tip {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.7;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
}

.tip-inline {
  margin: -12rpx 0 16rpx;
  font-size: 23rpx;
}

/* 已设置的调休列表 */
.m-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.m-item:last-child { border-bottom: none; }

.m-main { flex: 1; }

.m-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.m-desc {
  font-size: 25rpx;
  color: #2563eb;
  margin-top: 6rpx;
}

.del {
  color: #ef4444;
  font-size: 25rpx;
  padding: 10rpx 20rpx;
  flex: none;
}

/* 弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 50;
}

.sheet {
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.field-label {
  font-size: 25rpx;
  color: #6b7280;
  margin: 24rpx 0 12rpx;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f3f4f6;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

/* 课表预览 */
.pv-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f8fafc;
}

.pv-period {
  font-size: 24rpx;
  color: #2563eb;
  width: 90rpx;
  flex: none;
}

.pv-subject {
  font-size: 27rpx;
  color: #1f2937;
  font-weight: 600;
}

.pv-time {
  margin-left: auto;
  font-size: 21rpx;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 0;
}

.btn-row .btn {
  flex: 1;
  margin-bottom: 0;
}