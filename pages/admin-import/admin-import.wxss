.tip {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.7;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
}

.field-label {
  font-size: 26rpx;
  color: #6b7280;
  margin: 20rpx 0 14rpx;
}

.cp-row {
  display: flex;
  flex-wrap: wrap;
}

.cp {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  font-size: 25rpx;
  color: #4b5563;
  margin: 0 12rpx 12rpx 0;
}

.cp.on {
  background: #2563eb;
  color: #ffffff;
}

.file-name {
  font-size: 24rpx;
  color: #2563eb;
  margin: 14rpx 0;
}

.textarea {
  min-height: 260rpx;
  margin-bottom: 24rpx;
}

.result-msg {
  font-size: 28rpx;
  font-weight: 600;
  color: #15803d;
  margin-bottom: 12rpx;
}

.mt {
  margin-top: 16rpx;
}

.preview {
  width: 100%;
  border: 2rpx solid #f1f5f9;
  border-radius: 12rpx;
  padding: 8rpx;
  background: #f8fafc;
}

.pv-inner {
  display: inline-block;
  min-width: 100%;
}

.pv-row {
  display: flex;
  flex-direction: row;
}

.pv-cell {
  flex: 0 0 auto;
  max-width: 220rpx;
  padding: 10rpx 16rpx;
  font-size: 22rpx;
  color: #374151;
  border-right: 2rpx solid #f1f5f9;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}