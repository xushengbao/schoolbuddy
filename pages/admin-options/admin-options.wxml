<view class="page">
  <view class="card">
    <view class="card-title">学生状态选项</view>
    <view class="tip">这些选项会出现在学生状态设置里。默认包含「正常」，不可删除。</view>

    <view class="opt-row">
      <view class="opt {{item === '正常' ? 'on locked' : ''}}" wx:for="{{options}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="add-row">
      <input class="input add-input" placeholder="新增状态名称" value="{{draft}}" bindinput="onInput" />
      <view class="btn btn-sm add-btn" bindtap="add">添加</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">管理</view>
    <view class="opt-row">
      <view class="opt opt-del" wx:for="{{options}}" wx:key="*this"
        wx:if="{{item !== '正常'}}" catchtap="del" data-v="{{item}}">{{item}} ✕</view>
    </view>
    <view class="btn" bindtap="save">保存设置</view>
  </view>

  <view style="height:40rpx"></view>
</view>