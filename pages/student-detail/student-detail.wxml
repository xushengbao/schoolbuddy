<view class="page">
  <view class="card" wx:if="{{student}}">
    <view class="card-title">{{student.name}} · 状态设置</view>
    <view class="muted">学号 {{student.student_no}}　{{className}}</view>

    <view class="divider"></view>
    <view class="sub-title">全天状态</view>
    <view class="opt-row">
      <view
        class="opt {{dayStatus === item ? 'on' : ''}}"
        wx:for="{{options}}"
        wx:key="*this"
        bindtap="setDayStatus"
        data-v="{{item}}"
      >{{item}}</view>
    </view>
    <view class="muted current">当前：{{dayStatus || '正常（在位）'}}</view>

    <view class="divider"></view>
    <view class="sub-title">单节状态</view>
    <view class="period-block" wx:for="{{periods}}" wx:key="period">
      <view class="period-head">
        <text class="period-name">{{item.label}}　{{item.start}}-{{item.end}}</text>
        <text class="tag" wx:if="{{statusMap[item.period]}}" style="background:#eff6ff;color:#1d4ed8">{{statusMap[item.period]}}</text>
      </view>
      <view class="opt-row">
        <view
          class="opt {{statusMap[item.period] === opt ? 'on' : ''}}"
          wx:for="{{options}}"
          wx:for-item="opt"
          wx:key="*this"
          bindtap="setPeriodStatus"
          data-p="{{item.period}}"
          data-v="{{opt}}"
        >{{opt}}</view>
      </view>
    </view>

    <view class="divider"></view>
    <view class="field-label">备注（选填）</view>
    <textarea class="input textarea" placeholder="例如：发热，需家长接回" value="{{note}}" bindinput="onNoteInput" auto-height></textarea>
    <view class="btn btn-sm" bindtap="saveNote">保存备注</view>
  </view>

  <view style="height:40rpx"></view>
</view>