<view class="page">
  <view class="card" wx:if="{{notice}}">
    <view class="n-tag">{{notice.category}}</view>
    <view class="n-title">{{notice.title}}</view>
    <view class="n-time muted">{{notice.timeText}}</view>
    <view class="divider"></view>
    <view class="n-body">{{notice.content}}</view>
  </view>

  <view class="card" wx:if="{{notice && notice.related_class_id}}">
    <view class="card-title">相关操作</view>
    <view class="btn btn-ghost btn-sm" bindtap="goSwapList">查看换课申请</view>
  </view>

  <view style="height:40rpx"></view>
</view>