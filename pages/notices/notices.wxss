.filter-row {
  display: flex;
  margin-bottom: 10rpx;
}

.fr {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  font-size: 25rpx;
  color: #4b5563;
}

.fr.on {
  background: #2563eb;
  color: #ffffff;
}

.notice {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f8fafc;
}

.notice:last-child { border-bottom: none; }

.notice.unread {
  background: #f8fbff;
}

.n-title {
  font-size: 28rpx;
  font-weight: 600;
  flex: 1;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ef4444;
  margin-left: 12rpx;
}

.n-content {
  font-size: 25rpx;
  color: #4b5563;
  margin: 10rpx 0;
  line-height: 1.6;
}

.n-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.n-cat {
  background: #eff6ff;
  color: #1d4ed8;
}