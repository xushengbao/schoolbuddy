<view class="page">
  <view class="card">
    <view class="card-title">添加备忘</view>
    <textarea class="input textarea" placeholder="例如：下午3点与年级组长开会" value="{{draft}}" bindinput="onInput" auto-height></textarea>
    <view class="row">
      <view class="btn btn-sm add" bindtap="add">添加</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">
      <text>全部备忘（{{items.length}}）</text>
      <text class="link" bindtap="clearDone">清除已完成</text>
    </view>
    <view wx:if="{{items.length === 0}}" class="empty">还没有备忘事项</view>
    <view class="m-row" wx:for="{{items}}" wx:key="id">
      <view class="checkbox {{item.done ? 'checked' : ''}}" bindtap="toggle" data-id="{{item.id}}" data-done="{{item.done}}"></view>
      <view class="m-content {{item.done ? 'done' : ''}}" bindtap="toggle" data-id="{{item.id}}" data-done="{{item.done}}">{{item.content}}</view>
      <text class="del" bindtap="del" data-id="{{item.id}}">删除</text>
    </view>
  </view>

  <view style="height:40rpx"></view>
</view>