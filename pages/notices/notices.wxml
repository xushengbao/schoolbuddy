<view class="page">
  <view class="card">
    <view class="card-title">
      <text>站内信</text>
      <text class="link" bindtap="markAll">全部已读</text>
    </view>
    <view class="filter-row">
      <view class="fr {{onlyUnread ? 'on' : ''}}" bindtap="toggleUnread">仅看未读{{unreadCount ? '(' + unreadCount + ')' : ''}}</view>
    </view>
    <view wx:if="{{notices.length === 0}}" class="empty">暂无站内信</view>
    <view class="notice {{item.is_read ? '' : 'unread'}}" wx:for="{{notices}}" wx:key="id"
      bindtap="openNotice" data-id="{{item.id}}">
      <view class="row">
        <text class="n-title">{{item.title}}</text>
        <text class="dot" wx:if="{{!item.is_read}}"></text>
      </view>
      <view class="n-content">{{item.content}}</view>
      <view class="n-foot">
        <text class="tag n-cat">{{item.category}}</text>
        <text class="muted">{{item.timeText}}</text>
      </view>
    </view>
  </view>
  <view style="height:40rpx"></view>
</view>