.field-label {
  font-size: 26rpx;
  color: #6b7280;
  margin: 20rpx 0 14rpx;
}

.class-picker {
  display: flex;
  flex-wrap: wrap;
}

.cp {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  font-size: 25rpx;
  color: #4b5563;
  margin: 0 12rpx 12rpx 0;
}

.cp.on {
  background: #2563eb;
  color: #ffffff;
}

.mode-row {
  display: flex;
  gap: 20rpx;
}

.mode {
  flex: 1;
  background: #f3f4f6;
  border: 3rpx solid transparent;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
}

.mode.on {
  background: #eff6ff;
  border-color: #2563eb;
}

.mode-ico {
  font-size: 40rpx;
}

.mode-name {
  font-size: 27rpx;
  font-weight: 600;
  margin: 8rpx 0 4rpx;
}

.mode-desc {
  font-size: 21rpx;
  color: #6b7280;
}

.textarea {
  min-height: 160rpx;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 0 24rpx;
}

.quick {
  padding: 10rpx 20rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #4b5563;
  margin: 0 12rpx 12rpx 0;
}

.h-item {
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f8fafc;
}

.h-item:last-child { border-bottom: none; }

.h-content {
  font-size: 26rpx;
  margin-top: 10rpx;
  color: #374151;
}

.tag-voice {
  background: #0d9488;
  color: #ffffff;
}
/* 第七轮新增：语音模式提示、发送按钮并排、发送说明 */
.btn-row {
  display: flex;
  gap: 20rpx;
}

.btn-row .btn {
  flex: 1;
}

.btn-row .btn-ghost {
  flex: none;
  padding-left: 34rpx;
  padding-right: 34rpx;
  color: #0d9488;
  border-color: #99f6e4;
}

.tts-warn {
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #fffbeb;
  border: 2rpx solid #fcd34d;
  color: #92400e;
  font-size: 23rpx;
  line-height: 1.6;
}

.send-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #94a3b8;
  text-align: center;
}
