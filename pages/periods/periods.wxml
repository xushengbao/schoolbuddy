<view class="page">
  <view class="card">
    <view class="card-title">作息时间</view>
    <view class="tip">课表显示、当前节次判断、以及上课前 10 分钟提醒都依据这里的节次时间。</view>

    <view class="p-item" wx:for="{{periods}}" wx:key="period">
      <view class="p-no" bindtap="remove" data-idx="{{index}}">✕</view>
      <view class="p-fields">
        <input class="p-input label" value="{{item.label}}" data-idx="{{index}}" data-k="label" bindinput="onEdit" placeholder="名称" />
        <view class="time-row">
          <text class="time-label">开始</text>
          <picker mode="time" value="{{item.start}}" data-idx="{{index}}" bindchange="onTime" data-k="start">
            <view class="p-input time">{{item.start}}</view>
          </picker>
          <text class="time-label">结束</text>
          <picker mode="time" value="{{item.end}}" data-idx="{{index}}" bindchange="onTime" data-k="end">
            <view class="p-input time">{{item.end}}</view>
          </picker>
        </view>
      </view>
    </view>

    <view class="btn btn-ghost btn-sm" bindtap="addPeriod">新增一节</view>
  </view>

  <view class="card">
    <view class="btn" bindtap="save">保存作息时间</view>
  </view>

  <view style="height:40rpx"></view>
</view>