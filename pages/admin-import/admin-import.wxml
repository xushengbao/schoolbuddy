<view class="page">
  <view class="card">
    <view class="card-title">{{title}}</view>
    <view class="tip">{{tip}}</view>
  </view>

  <!-- 超级管理员需先选择学校 -->
  <view wx:if="{{isSuper}}" class="card">
    <view class="field-label">目标学校</view>
    <view class="cp-row" wx:if="{{schools.length}}">
      <view class="cp {{schoolId === item.id ? 'on' : ''}}" wx:for="{{schools}}" wx:key="id"
        bindtap="pickSchool" data-id="{{item.id}}">{{item.name}}</view>
    </view>
    <view class="muted" wx:if="{{!schools.length}}">还没有学校，请先在「平台管理」创建或导入。</view>
  </view>

  <!-- 学生导入的兜底班级选择 -->
  <view wx:if="{{type === 'students' && classes.length}}" class="card">
    <view class="field-label">默认班级</view>
    <view class="muted">表格中的「班级」列会自动定位班级，此处仅作为兜底。</view>
    <view class="cp-row">
      <view class="cp {{classId === item.id ? 'on' : ''}}" wx:for="{{classes}}" wx:key="id"
        bindtap="pickClass" data-id="{{item.id}}">{{item.name}}</view>
    </view>
  </view>

  <!-- 选择文件 -->
  <view class="card">
    <view class="field-label">选择文件</view>
    <view class="muted">支持 .xls、.xlsx、.csv 三种格式，可直接把 Excel 原文件发到聊天记录里选择。</view>
    <view class="btn btn-ghost btn-sm mt" bindtap="pickFile">从聊天记录选择文件</view>

    <view class="file-name" wx:if="{{fileName}}">
      已读取 {{fileName}}（{{sheets.length}} 个工作表）
    </view>

    <view class="muted mt" wx:if="{{sheetNames.length > 1}}">工作表：{{sheetNames.join('、')}}</view>

    <view class="mt" wx:if="{{preview.length}}">
      <view class="field-label">首个工作表预览</view>
      <scroll-view scroll-x class="preview">
        <view class="pv-inner">
          <view class="pv-row" wx:for="{{preview}}" wx:key="index" wx:for-item="row">
            <text class="pv-cell" wx:for="{{row}}" wx:key="index" wx:for-item="cell">{{cell}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 导入结果 -->
  <view class="card" wx:if="{{result}}">
    <view class="card-title">导入结果</view>
    <view class="result-msg">{{result.message}}</view>
    <view class="muted" wx:for="{{result.errors}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="card">
    <view class="btn" bindtap="submit" loading="{{busy}}" disabled="{{busy || !sheets}}">开始导入</view>
  </view>

  <view style="height:40rpx"></view>
</view>