.hero {
  background: linear-gradient(150deg, #0d9488 0%, #0f766e 100%);
  padding: 40rpx 32rpx 32rpx;
  color: #ffffff;
}

.hero-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-left {
  flex: 1;
}

.hero-date {
  font-size: 30rpx;
  opacity: 0.9;
}

.hero-time {
  font-size: 68rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 2rpx;
  margin: 6rpx 0;
}

.hero-greet {
  font-size: 30rpx;
  font-weight: 600;
  opacity: 0.95;
}

.hero-period {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  font-size: 25rpx;
  display: flex;
  align-items: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fde047;
  margin-right: 12rpx;
}

.link {
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 400;
}

.msg {
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 14rpx;
  margin-bottom: 16rpx;
}

.msg-voice {
  background: #ecfdf5;
}

.msg-head {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.msg-teacher {
  font-size: 25rpx;
  font-weight: 600;
  color: #374151;
  margin-right: 12rpx;
}

.msg-mode {
  background: #0d9488;
  color: #ffffff;
}

.msg-mode-text {
  font-size: 21rpx;
  color: #9ca3af;
}

.msg-content {
  font-size: 28rpx;
  line-height: 1.6;
}

.msg-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.msg-time {
  font-size: 21rpx;
  color: #9ca3af;
}

.msg-play {
  font-size: 22rpx;
  color: #0d9488;
  border: 2rpx solid #99f6e4;
  background: #f0fdfa;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

.lesson {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.lesson:last-child {
  border-bottom: none;
}

.lesson-now {
  background: #ecfdf5;
  margin: 0 -16rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
  border-radius: 12rpx;
}

.lesson-period {
  width: 110rpx;
  text-align: center;
  flex-shrink: 0;
}

.period-no {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f766e;
  line-height: 1.1;
}

.period-label {
  font-size: 20rpx;
  color: #9ca3af;
}

.lesson-main {
  flex: 1;
  padding-left: 12rpx;
}

.lesson-subject {
  font-size: 30rpx;
  font-weight: 600;
}

.lesson-meta {
  font-size: 23rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

.badge {
  font-size: 19rpx;
  background: #f59e0b;
  color: #ffffff;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-left: 8rpx;
  vertical-align: middle;
}

.stat-row {
  display: flex;
  justify-content: space-around;
}

.stat {
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
}

.stat-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

.sub-title {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 14rpx;
}

.period-status {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f8fafc;
}

.period-status:last-child {
  border-bottom: none;
}

.ps-name {
  width: 150rpx;
  font-size: 25rpx;
  color: #374151;
  flex-shrink: 0;
}

.ps-chips {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
}

.chip {
  margin: 0 10rpx 6rpx 0;
}

.memo {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f8fafc;
}

.memo:last-child {
  border-bottom: none;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #d1d5db;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #0d9488;
  border-color: #0d9488;
}

.done {
  text-decoration: line-through;
  color: #9ca3af;
}
/* 调休提示：当天按另一个工作日的课表上课 */
.makeup-tip {
  font-size: 23rpx;
  color: #b45309;
  background: #fffbeb;
  border-left: 6rpx solid #f59e0b;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
  line-height: 1.5;
}
