.tip {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.7;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
}

.p-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.p-no {
  width: 60rpx;
  text-align: center;
  color: #ef4444;
  font-size: 26rpx;
  padding-top: 18rpx;
}

.p-fields { flex: 1; }

.p-input {
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 27rpx;
  margin-bottom: 12rpx;
}

.label { width: 100%; }

.time-row {
  display: flex;
  align-items: center;
}

.time-label {
  font-size: 23rpx;
  color: #6b7280;
  margin: 0 12rpx 12rpx 0;
}

.time {
  width: 180rpx;
  margin-bottom: 12rpx;
}