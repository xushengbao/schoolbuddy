.head {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #dbeafe;
  color: #1d4ed8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  margin-right: 24rpx;
}

.head-main { flex: 1; }

.h-name {
  font-size: 34rpx;
  font-weight: 700;
}

.sub-title {
  font-size: 27rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.week-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.wt {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
  background: #f1f5f9;
  font-size: 25rpx;
  color: #4b5563;
}

.wt.on {
  background: #2563eb;
  color: #ffffff;
}

.row-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.row-item:last-child { border-bottom: none; }

.p-no {
  width: 70rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #2563eb;
}

.p-body { flex: 1; }

.p-subject {
  font-size: 28rpx;
  font-weight: 600;
}

.badge {
  font-size: 19rpx;
  background: #f59e0b;
  color: #fff;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-left: 8rpx;
}

.opt-row {
  display: flex;
  flex-wrap: wrap;
}

.opt {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  font-size: 25rpx;
  color: #4b5563;
  margin: 0 14rpx 12rpx 0;
}

.opt.on {
  background: #2563eb;
  color: #ffffff;
}