<view class="page">
  <view class="card" wx:if="{{teacher}}">
    <view class="head">
      <view class="avatar">{{teacher.name[0]}}</view>
      <view class="head-main">
        <view class="h-name">{{teacher.name}}</view>
        <view class="muted">{{teacher.subject_group}}　账号 {{teacher.account}}</view>
      </view>
      <text class="tag" style="background:{{teacher.bg}};color:{{teacher.color}}">{{teacher.status}}</text>
    </view>

    <view class="divider"></view>
    <view class="sub-title">本周总课表</view>
    <view class="hint">共 {{totalLessons}} 节课 · 点格子看班级与换课说明</view>

    <scroll-view class="grid-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <view class="grid">
        <view class="g-row g-head">
          <view class="g-corner">节次</view>
          <view class="g-col" wx:for="{{weekdays}}" wx:key="w">
            <view class="g-head-name {{item.w === todayWeekday ? 'today' : ''}}">{{item.name}}</view>
          </view>
        </view>

        <view class="g-row" wx:for="{{rows}}" wx:key="period" wx:for-item="row">
          <view class="g-corner">
            <view class="g-corner-label">{{row.label}}</view>
            <view class="g-corner-time">{{row.timeText}}</view>
          </view>
          <view
            class="g-col"
            wx:for="{{row.cells}}"
            wx:key="key"
            wx:for-item="cell"
            bindtap="tapCell"
            data-subject="{{cell.subject}}"
            data-class-name="{{cell.className}}"
            data-swap-text="{{cell.swapText}}"
            data-weekday="{{cell.weekday}}"
            data-period="{{cell.period}}"
            data-time-text="{{row.timeText}}"
          >
            <view class="g-cell {{cell.subject ? '' : 'empty-cell'}} {{cell.isToday ? 'today-col' : ''}} {{cell.swapped ? 'swapped' : ''}}">
              <view class="g-subject" wx:if="{{cell.subject}}">{{cell.shortName}}</view>
              <view class="g-class" wx:if="{{cell.subject && cell.shortClass}}">{{cell.shortClass}}</view>
              <view class="g-swap" wx:if="{{cell.swapped}}">换</view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="empty" wx:if="{{totalLessons === 0}}">
      这位老师本周还没有课。若课表已导入但这里为空，说明课表里的教师姓名还没匹配上教师账号，请管理员补齐「教师账号」后重新导入课表。
    </view>

    <block wx:if="{{isSelf}}">
      <view class="divider"></view>
      <view class="sub-title">修改我的状态</view>
      <view class="opt-row">
        <view class="opt {{teacher.status === item ? 'on' : ''}}" wx:for="{{statusOptions}}" wx:key="*this"
          bindtap="setStatus" data-v="{{item}}">{{item}}</view>
      </view>
    </block>
  </view>

  <view style="height:40rpx"></view>
</view>